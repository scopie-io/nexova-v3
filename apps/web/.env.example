# Copy to .env.local. Values come from the Supabase dashboard: Project Settings > API Keys.

# Public: safe in the browser, RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://njibepgtgyqnjmioyucz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only: bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Origin used in auth email links and OAuth redirects. Must be listed in
# Supabase > Authentication > URL Configuration > Redirect URLs as <origin>/auth/callback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
