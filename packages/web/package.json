{
  "name": "@nexova/web",
  "version": "0.1.0",
  "description": "Nexova web app: paste links -> watch the build -> open your live store",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
