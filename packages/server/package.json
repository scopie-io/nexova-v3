{
  "name": "@nexova/server",
  "version": "0.1.0",
  "description": "Nexova HTTP API + SSE progress + static hosting for generated stores",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "bundle:templates": "node ../../scripts/bundle-templates.mjs",
    "dev:cloud": "npm run bundle:templates && nitro dev",
    "build:cloud": "npm run bundle:templates && nitro build"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "nitro": "^3.0.260903-beta",
    "rollup": "^4.63.1",
    "workflow": "^4.8.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
