# ---- Claude ----
# Your Anthropic API key. Never commit the real .env file.
ANTHROPIC_API_KEY=sk-ant-...
# Model used for research / normalization / enrichment (default: claude-opus-5)
NEXOVA_MODEL=claude-opus-5
# Effort for Claude calls: low | medium | high | xhigh | max (default: high)
NEXOVA_EFFORT=high
# Server-side refusal fallback model (set to "off" to disable)
NEXOVA_FALLBACK_MODEL=claude-opus-4-8

# ---- Engine ----
# Root folder where generated stores are written
NEXOVA_STORES_DIR=./stores
# Root folder for job state, cache, and the usage ledger
NEXOVA_DATA_DIR=./data
# Folder containing the React templates (each with nexova.template.json)
NEXOVA_TEMPLATES_DIR=./templates
# Max products to keep per store (default 60)
NEXOVA_MAX_PRODUCTS=60
# Cache TTL for source extraction, in hours (default 24)
NEXOVA_CACHE_TTL_HOURS=24
# Set to 1 to enable the optional Playwright provider (requires `npm i playwright` + browsers)
NEXOVA_BROWSER=0

# ---- Server ----
PORT=4000
# Public base URL used when reporting the live store URL
NEXOVA_PUBLIC_URL=http://localhost:4000

# ---- Deploy (optional) ----
# local | netlify | vercel
NEXOVA_DEPLOY_TARGET=local
NETLIFY_AUTH_TOKEN=
# For NEXOVA_DEPLOY_TARGET=vercel: each store becomes its own Vercel project (nexova-<slug>).
# Token from https://vercel.com/account/tokens with access to the team; team id from `.vercel/project.json` (orgId).
# On the Vercel project itself use NEXOVA_VERCEL_TOKEN (the VERCEL_ prefix is reserved there).
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ---- Storage ----
# auto (default) | fs | vercel. "auto" uses Neon + Blob when both DATABASE_URL and BLOB_READ_WRITE_TOKEN are set,
# otherwise data/ and stores/ on disk. `vercel env pull .env.local` fills both after provisioning through the Marketplace.
NEXOVA_STORAGE=auto
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# ---- Ingestion strategy ladder ----
# Rendered-page reader for bot-blocked/JS-heavy pages: auto | off | jina | firecrawl | proxy
NEXOVA_READER=auto
# Optional keys for readers (Jina works keyless with lower rate limits)
JINA_API_KEY=
FIRECRAWL_API_KEY=
# Generic scraping proxy template, {url} is replaced with the encoded page URL
# NEXOVA_PROXY_URL=https://app.scrapingbee.com/api/v1/?api_key=KEY&render_js=true&url={url}
# Follow bio links / on-page links (1) and search for missing channels (1)
NEXOVA_DISCOVERY=1
NEXOVA_SEARCH_DISCOVERY=1
NEXOVA_MAX_DISCOVERED=6
# Wayback Machine fallback for blocked pages
NEXOVA_WAYBACK=1
# Max screenshots per job sent to Claude vision
NEXOVA_MAX_VISION_IMAGES=20

# ---- TikTok Shop (RapidAPI) ----
# TikTok Shop never renders its catalog to bots. With a RapidAPI key for
# "TikTok Shop API - Product Search, Seller Data, Reviews" (api-burst), a pasted TikTok Shop
# store or product link returns the real listings: titles, prices, photos, ratings, sold counts,
# variants and stock, plus the seller profile. Every request costs one credit on your plan.
# https://rapidapi.com/api-burst-api-burst-default/api/tiktok-shop-api-product-search-seller-data-reviews
RAPIDAPI_KEY=
# Regions to try, in order, when the link does not say which TikTok Shop market it belongs to
# (US, GB, DE, FR, IT, ID, MY, MX, PH, SG, ES, TH, VN, BR, JP, IE). Each miss costs one credit.
NEXOVA_TIKTOK_SHOP_REGIONS=MY,SG,US
# Catalog pages per shop (20 products each, one credit per page)
NEXOVA_TIKTOK_SHOP_MAX_PAGES=3
# Products per shop enriched with full details (description, all photos, variants, stock); one credit each
NEXOVA_TIKTOK_SHOP_DETAILS=6

# ---- Shopee (RapidAPI, same RAPIDAPI_KEY) ----
# Catalog scraper: RapidAPI "Shopee Product Scraper" (gioopasquale). Subscribe separately from the
# TikTok Shop API; it is async (submit -> poll) and bills per product returned, so it only runs
# when Shopee's own endpoints came up empty. Countries: BR, ID, TH, MY, SG, PH, VN, MX.
# Budget for one scrape including polling (ms); must stay under the 60s provider timeout.
NEXOVA_SHOPEE_TIMEOUT_MS=45000
