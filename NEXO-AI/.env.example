# NEXO.AI — configuration. This file is gitignored. Do not commit.

# ---- The brain: Claude via the Anthropic API ----
# Paste your Anthropic API key here (sk-ant-...). Leave blank = demo mode.
ANTHROPIC_API_KEY=

# Model NEXO thinks and builds with (claude-opus-5 = most capable; claude-sonnet-5 = faster/cheaper)
CLAUDE_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max  (high = best balance; medium = snappier)
CLAUDE_EFFORT=high

# Max output tokens per reply (a full single-file website needs room)
MAX_TOKENS=16000

# ---- The voice: Qwen TTS via DashScope (optional — browser speech is used if blank) ----
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# Voice NEXO speaks with (Neil / Ethan / Dylan / Marcus / Ryan)
NEXO_VOICE=Ethan

# Port the app runs on
PORT=3200
